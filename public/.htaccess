# Apache settings for cPanel hosting. Vite copies this file into docs/ on build.
# Paths are relative, so the site works in public_html or any subfolder.

DirectoryIndex index.html
Options -Indexes

# Browsers refuse module scripts and fonts served with the wrong type.
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType application/pdf .pdf
  AddCharset utf-8 .html .css .js .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Always revalidate the page so visitors pick up new builds.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Vite's hashed bundles (e.g. index-D8oscuXV.js) never change in place.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images, icons, and the résumé keep their names when replaced.
  <FilesMatch "\.(png|jpe?g|svg|woff2?|ttf|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
